--- /dev/null
+++ b/BANG_Base/bang_preprocess_mul.py
@@ -0,0 +1,110 @@
+import struct
+import sys
+import numpy as np
+import os
+
+print("*** Ensure to update the SECTOR LENGTH in the Script (if non-default sector lengths are used during DiskANN graph build)")
+
+if len(sys.argv) != 6:
+    print("Usage :", sys.argv[0], "<path to DiskANN graph index file (.index)> <path to store the o/p pre-process file for use by BANG (.bin)> <dataset dimension> <dataset datatype: 0 -> int8, 1 -> uint8, 2 -> float> <degree (i.e. R) of the DiskANN graph index>")
+    exit()
+
+file_to_read = sys.argv[1]  # INDEX FILE
+file_to_write = sys.argv[2]  # BIN FILE
+DIM = int(sys.argv[3])         # No of dimensions
+DATATYPE = int(sys.argv[4])    # Data Type of base dataset
+DEGREE = int(sys.argv[5])
+SECTORLEN = 4096    # Mentioned in pq_flash_index.h
+DATATYPESIZE = 4 if DATATYPE == 2 else 1
+
+w = open(file_to_write, "wb")
+file1_to_write = file_to_write[:len(file_to_write)-4] + "_metadata" + file_to_write[len(file_to_write)-4:]
+w1 = open(file1_to_write, "wb")
+
+with open(file_to_read, "rb") as f:
+    a = f.read(8)
+    filesize = struct.unpack('<Q', a)[0]
+    filesize = os.path.getsize(file_to_read)
+    print("filesize:", filesize)
+
+    a = f.read(8)
+    total_nodes = struct.unpack('<Q', a)[0]
+    print("total_nodes:", total_nodes)
+
+    a = f.read(8)
+    medoid = struct.unpack('<Q', a)[0]
+    print("Medoid is:", medoid)
+    w1.write(a)
+
+    a = f.read(8)
+    maxNodeLen = struct.unpack('<Q', a)[0]
+    print("maxNodeLen:", maxNodeLen)
+    NODELEN = DIM * DATATYPESIZE + 4 + DEGREE * 4
+    print(NODELEN)
+    w1.write(struct.pack('<Q', NODELEN))
+
+    a = f.read(8)
+    nodesPerSec = struct.unpack('<Q', a)[0]
+    print("nodesPerSec:", nodesPerSec)
+
+    w1.write(struct.pack('<I', int(DATATYPE)))
+    w1.write(struct.pack('<I', int(DIM)))
+    w1.write(struct.pack('<I', int(DEGREE)))
+    print("Datatype =", DATATYPE, "Datatype size =", DATATYPESIZE)
+
+    if NODELEN > SECTORLEN:
+        nsectors_per_node = int(np.ceil(NODELEN / SECTORLEN))
+    else:
+        nsectors_per_node = 1
+
+    NodesRead = 0
+    sector_count = int((filesize - SECTORLEN) / SECTORLEN)
+    sector_offset = SECTORLEN
+
+    if NODELEN > SECTORLEN:
+        nsectors_per_node = int(np.ceil(NODELEN / SECTORLEN))
+        sector_offset = SECTORLEN
+        NodesRead = 0
+        while NodesRead < total_nodes:
+            f.seek(sector_offset, 0)
+            node_bytes = b''
+            for s in range(nsectors_per_node):
+                node_bytes += f.read(SECTORLEN)
+            node_bytes = node_bytes[:NODELEN]
+            sector_offset += nsectors_per_node * SECTORLEN
+
+            offset_in_node = 0
+            for dim in range(DIM):
+                data = node_bytes[offset_in_node:offset_in_node+DATATYPESIZE]
+                w.write(data)
+                offset_in_node += DATATYPESIZE
+
+            a = node_bytes[offset_in_node:offset_in_node+4]
+            w.write(a)
+            d = struct.unpack('<I', a)[0]
+            offset_in_node += 4
+            if d > DEGREE or d == 0:
+                print("crap")
+                exit()
+
+            arr = np.zeros(d, dtype='<u4')
+            for k in range(d):
+                a = node_bytes[offset_in_node:offset_in_node+4]
+                neighbour = struct.unpack("<I", a)[0]
+                arr[k] = neighbour
+                offset_in_node += 4
+            arr_sorted = np.sort(arr)
+            for l in range(d):
+                w.write(struct.pack("<I", arr_sorted[l]))
+            for l in range(DEGREE - d):
+                w.write(struct.pack("<I", 0))
+
+            NodesRead += 1
+            if NodesRead % 10000 == 0:
+                print("NodesRead:", NodesRead)
+
+    print("Total # of Nodes Discovered =", NodesRead )
+    w1.write(struct.pack('<I', int(NodesRead)))
+
+    w.close()
+    w1.close()
