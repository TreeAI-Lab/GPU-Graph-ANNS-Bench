+__global__
+void SearchK_Stats(float* d, 
+    float* q,
+    int* ann,
+    int* g,
+    int n_d,
+    int n_q,
+    int s_bits,
+    int M,
+    int k,
+    int n_e,
+    unsigned long long* tb,
+    unsigned long long* cal_count,
+    unsigned long long* path_length)
+{
+    int n_warp = blockDim.x / 32;
+    int warp_id = threadIdx.x / 32;
+    int lane_id = threadIdx.x % 32;
+    int b_id = blockIdx.x;
+
+    extern __shared__ NBR sm[];
+    NBR* s_nbr = sm + warp_id * ((1 << s_bits) + M);
+    int* s_f = (int*)(sm + n_warp * ((1 << s_bits) + M)) + warp_id * ((1 << s_bits) + M);
+    
+    int id = b_id * n_warp + warp_id;
+    int* ann_seg = ann + id * k;
+    unsigned long long* tb_seg = tb + (size_t)id * 6;
+    
+    int g_f = 1;
+    int f_f = 0;
+    NBR init_value;
+    init_value.d = Max;
+    init_value.nbr = n_d;
+
+    if (id >= n_q) {
+        return;
+    }
+
+    for (int i = 0; i < ((1 << s_bits) + M + WS - 1) / WS; i++) {
+        int l_id = lane_id + WS * i;
+
+        if (l_id < (1 << s_bits) + M) {
+            s_f[l_id] = 0;
+            s_nbr[l_id] = init_value;
+        }
+    }
+
+    if (lane_id == 0) {
+        s_nbr[0].nbr = 0;
+    }
+
+    int nbr_id = 0;
+    
+    float dist = compute_dist_q(lane_id, id, nbr_id, d, q);
+    
+    if (lane_id == 0) {
+        s_nbr[0].d = dist;
+    }
+   	
+    while (g_f) {
+
+        if (lane_id == 0) {
+            s_f[f_f] = 0;
+            atomicAdd(path_length, 1ULL);
+        }
+        
+        nbr_id = s_nbr[f_f].nbr;
+        int* nbr_nbr = g + ((size_t)nbr_id << s_bits);
+
+        long long t2 = clock64();
+        for (int i = 0; i < ((1 << s_bits) + WS - 1) / WS; i++) {
+            int l_id = lane_id + WS * i;
+
+            if (l_id < (1 << s_bits)) {
+                s_nbr[M + l_id].nbr = nbr_nbr[l_id];
+                s_f[M + l_id] = 1;
+            }
+        }
+        long long t3 = clock64();
+
+        for (int i = 0; i < (1 << s_bits); i++) {
+            nbr_id = s_nbr[M + i].nbr;
+            
+            if (nbr_id >= n_d) {
+                s_nbr[M + i].d = Max;
+                continue;
+            }
+            if (lane_id == 0) {
+                atomicAdd(cal_count, 1ULL);
+            }
+            
+            dist = compute_dist_q(lane_id, id, nbr_id, d, q);
+                
+            if (lane_id == 0) {
+                s_nbr[M + i].d = dist;
+            }
+        }
+        
+        long long t4 = clock64();
+        binary_search(lane_id, (1 << s_bits), M, s_nbr);
+        long long t5 = clock64();
+
+        bitonic_sort(lane_id, (1 << s_bits), s_nbr + M, false);
+        long long t6 = clock64();
+        
+        bitonic_merge_triplet(lane_id, (1 << s_bits), M, s_nbr, s_f);
+        long long t1 = clock64();
+        
+        for (int i = 0; i < (n_e + WS - 1) / WS; i++) {
+            int l_id = lane_id + WS * i;
+            int f = 0;
+
+            if(l_id < n_e){
+                f = s_f[l_id];
+            }
+
+            f_f = __ballot_sync(FULL_MASK, f);
+
+            if(f_f != 0){
+                f_f = WS * i + __ffs(f_f) - 1;
+                break;
+            }else if(i == (n_e + WS - 1) / WS - 1){
+                g_f = 0;
+            }
+        }
+        long long t7 = clock64();
+
+        // stages of the original GANNS clocks: 1 pick the next candidate, 2 read its neighbor list,
+        // 3 distances, 4 drop visited neighbors, 5 sort the neighbors, 6 merge them into the candidates
+        if (lane_id == 0) {
+            tb_seg[0] += t7 - t1;
+            tb_seg[1] += t3 - t2;
+            tb_seg[2] += t4 - t3;
+            tb_seg[3] += t5 - t4;
+            tb_seg[4] += t6 - t5;
+            tb_seg[5] += t1 - t6;
+        }
+    }
+
+    for (int i = 0; i < (k + WS - 1) / WS; i++) {
+        int l_id = lane_id + WS * i;
+    
+        if (l_id < k) {
+            ann_seg[l_id] = s_nbr[l_id].nbr;
+        }
+    }
+}
