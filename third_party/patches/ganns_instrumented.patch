+    // The search with counters and stage clocks. The candidate list M is the smallest power of 2 from 64 that
+    // holds n_e entries and the 1 << s_bits adjacency slots, as in the resident search of the QPS-recall runs.
+    void search_stats(float* q, int k, int* &ann, int n_q, int n_e) {
+        int M = 64;
+        while (M < n_e || M < (1 << s_bits_)) {
+            M *= 2;
+        }
+        cout << "Parameters: k = " << k << ", n_e = " << n_e << ", M = " << M << endl;
+
+        cudaMallocHost(&ann, sizeof(int) * (size_t)n_q * k);
+        unsigned long long stages[6];
+        unsigned long long cal_count = 0, path_length = 0;
+        long long query_us = 0;
+        NSWOp::SearchStats(data_->get_vector(0), q, graph_, ann, n_q, data_->num(), data_->dim(), s_bits_, k, M,
+            n_e, stages, cal_count, path_length, query_us);
+
+        unsigned long long sum = 0;
+        for (int s = 0; s < 6; s++) {
+            sum += stages[s];
+        }
+        cout << "Query speed: " << (double)n_q / ((double)query_us / pow(10, 6)) << " queries per second" << endl;
+        cout << "query time: " << query_us << " us" << endl;
+        cout << "stages percentage:";
+        for (int s = 0; s < 6; s++) {
+            cout << " " << (double)stages[s] / sum;
+        }
+        cout << endl;
+        cout << "cal_count: " << cal_count << endl;
+        cout << "path_length: " << path_length << endl;
+    }
+
+    // Average out-degree (slots holding a vertex id) and the number of weakly connected components found by a
+    // BFS over the stored edges, as in the graph analysis of the original GANNS runs.
+    void analyze() {
+        const int slots = 1 << s_bits_;
+        long long edges = 0;
+        for (size_t i = 0; i < ((size_t)n_ << s_bits_); i++) {
+            if (graph_[i] < n_) {
+                edges++;
+            }
+        }
+        vector<bool> visited(n_, false);
+        int n_comp = 0, largest = 0;
+        for (int start = 0; start < n_; start++) {
+            if (visited[start]) continue;
+            n_comp++;
+            int sz = 0;
+            queue<int> bfs;
+            bfs.push(start);
+            visited[start] = true;
+            while (!bfs.empty()) {
+                int v = bfs.front();
+                bfs.pop();
+                sz++;
+                for (int j = 0; j < slots; j++) {
+                    int u = graph_[((size_t)v << s_bits_) + j];
+                    if (u < n_ && !visited[u]) {
+                        visited[u] = true;
+                        bfs.push(u);
+                    }
+                }
+            }
+            largest = max(largest, sz);
+        }
+        cout << "Number of nodes: " << n_ << endl;
+        cout << "Maximum degree: " << slots << endl;
+        cout << "Average degree: " << (double)edges / n_ << endl;
+        cout << "Number of components: " << n_comp << endl;
+        cout << "Largest component size: " << largest << " (" << largest * 100.0 / n_ << "% of nodes)" << endl;
+    }
