+	// Search with SearchK_Stats: the kernel time of the search, the six stage clocks summed over all queries,
+	// the number of distance computations (cal_count) and of expanded candidates (path_length).
+	static void SearchStats(float* h_d, 
+		float* h_q, 
+		int* h_g, 
+		int* h_ann, 
+		int n_q, 
+		int n_d, 
+		int d, 
+		int s_bits, 
+		int k, 
+		int M,
+		int n_e,
+		unsigned long long* stages,
+		unsigned long long& cal_count,
+		unsigned long long& path_length,
+		long long& query_us) {
+		float* d_d = copy_to_device<float>(h_d, (size_t)n_d * d);
+		float* d_q = copy_to_device<float>(h_q, (size_t)n_q * d);
+		int* d_ann = allocate_device_memory<int>((size_t)n_q * k);
+		int* d_g = copy_to_device<int>(h_g, (size_t)n_d << s_bits);
+		unsigned long long* d_tb = allocate_device_memory<unsigned long long>((size_t)n_q * 6);
+		unsigned long long* d_cnt = allocate_device_memory<unsigned long long>(2);
+		cudaMemset(d_tb, 0, (size_t)n_q * 6 * sizeof(unsigned long long));
+		cudaMemset(d_cnt, 0, 2 * sizeof(unsigned long long));
+
+		int block_dim = 256;
+		int grid_dim = (n_q + block_dim / WS - 1) / (block_dim / WS);
+		int shmem = ((1 << s_bits) + M) * (block_dim / WS) * (sizeof(NBR) + sizeof(int));
+		cudaFuncSetAttribute(SearchK_Stats, cudaFuncAttributeMaxDynamicSharedMemorySize, shmem);
+
+		auto t1 = std::chrono::steady_clock::now();
+		SearchK_Stats<<<grid_dim, block_dim, shmem>>>(d_d, d_q, d_ann, d_g, n_d, n_q, s_bits, M, k, n_e,
+			d_tb, d_cnt, d_cnt + 1);
+		cudaError_t err = cudaDeviceSynchronize();
+		auto t2 = std::chrono::steady_clock::now();
+		if (err == cudaSuccess) {
+			err = cudaGetLastError();
+		}
+		if (err != cudaSuccess) {
+			std::cerr << "SearchK_Stats failed: " << cudaGetErrorString(err) << std::endl;
+			exit(1);
+		}
+		query_us = std::chrono::duration_cast<std::chrono::microseconds>(t2 - t1).count();
+
+		unsigned long long* h_tb = copy_to_host<unsigned long long>(d_tb, (size_t)n_q * 6);
+		for (int s = 0; s < 6; s++) {
+			stages[s] = 0;
+		}
+		for (size_t i = 0; i < (size_t)n_q; i++) {
+			for (int s = 0; s < 6; s++) {
+				stages[s] += h_tb[i * 6 + s];
+			}
+		}
+		unsigned long long h_cnt[2];
+		cudaMemcpy(h_cnt, d_cnt, 2 * sizeof(unsigned long long), cudaMemcpyDeviceToHost);
+		cal_count = h_cnt[0];
+		path_length = h_cnt[1];
+		cudaMemcpy(h_ann, d_ann, (size_t)n_q * k * sizeof(int), cudaMemcpyDeviceToHost);
+
+		cudaFreeHost(h_tb);
+		cudaFree(d_cnt);
+		cudaFree(d_tb);
+		cudaFree(d_g);
+		cudaFree(d_ann);
+		cudaFree(d_q);
+		cudaFree(d_d);
+	}
