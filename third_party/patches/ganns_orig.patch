@@ -60,6 +60,65 @@ private:
     }
 
 public:
+    int GetOffsetShift() const { return offset_shift_; }
+    const int* GetGraph() const { return graph_; }
+    int GetNumPoints() const { return points_->GetNumPoints(); }
+
+    void AnalyzeGraph() const {
+        int num_points = GetNumPoints();
+        int max_degree = 1 << offset_shift_;
+        std::vector<bool> visited(num_points, false);
+        std::vector<int> component_sizes;
+
+        long long total_edges = 0;
+        for(int i = 0; i < num_points; i++) {
+            int degree = 0;
+            int offset = i << offset_shift_;
+            for(int j = 0; j < max_degree; j++) {
+                if(graph_[offset + j] < num_points) {
+                    degree++;
+                }
+            }
+            total_edges += degree;
+        }
+
+        int num_components = 0;
+        for(int start = 0; start < num_points; start++) {
+            if(visited[start]) continue;
+
+            num_components++;
+            int component_size = 0;
+            std::queue<int> q;
+            q.push(start);
+            visited[start] = true;
+
+            while(!q.empty()) {
+                int curr = q.front();
+                q.pop();
+                component_size++;
+
+                int offset = curr << offset_shift_;
+                for(int j = 0; j < max_degree; j++) {
+                    int neighbor = graph_[offset + j];
+                    if(neighbor < num_points && !visited[neighbor]) {
+                        visited[neighbor] = true;
+                        q.push(neighbor);
+                    }
+                }
+            }
+            component_sizes.push_back(component_size);
+        }
+
+        std::cout << "\n=== Graph Analysis Results ===" << std::endl;
+        std::cout << "Number of nodes: " << num_points << std::endl;
+        std::cout << "Maximum degree: " << max_degree << std::endl;
+        std::cout << "Average degree: " << (double)total_edges / num_points << std::endl;
+        std::cout << "Number of components: " << num_components << std::endl;
+
+        int max_component = *std::max_element(component_sizes.begin(), component_sizes.end());
+        std::cout << "Largest component size: " << max_component
+                 << " (" << (max_component * 100.0 / num_points) << "% of nodes)" << std::endl;
+    }
 
