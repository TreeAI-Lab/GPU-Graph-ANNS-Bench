# Baseline programs: Faiss HNSW (CPU), Faiss IVF-PQ (GPU), cuVS IVF-PQ and cuVS brute force.
# Run through build.sh, which sources env.sh for W, BIN_DIR, ENV_FAISS and ENV_CUVS.
#
#   make faiss   faiss_hnsw, faiss_ivf_pq        (Faiss from third_party/build/faiss.sh)
#   make cuvs    cuvs_ivf_pq, cuvs_brute_force   (cuVS from third_party/build/cuvs.sh)
#   make all     both

BIN_DIR ?= $(W)/bin
COMMON := ../common
EXTRA_LDFLAGS ?=

# ---------------------------------------------------------------- Faiss (CUDA 12.4 toolchain)
FAISS_SRC ?= $(W)/src/faiss
FAISS_INSTALL ?= $(W)/build/faiss/install

FAISS_CXX := $(ENV_FAISS)/bin/x86_64-conda-linux-gnu-c++
FAISS_CXXFLAGS := -std=c++20 -O3 -fopenmp -DNDEBUG
FAISS_INCLUDES := -I$(FAISS_INSTALL)/include -I$(FAISS_SRC) \
	-I$(ENV_FAISS)/targets/x86_64-linux/include -I$(COMMON) -I.
# -rpath-link: the conda linker resolves the dependencies of the CUDA libraries only there, not through -rpath,
# so a different CUDA on LD_LIBRARY_PATH would otherwise be picked up.
FAISS_LDFLAGS := -L$(FAISS_INSTALL)/lib -L$(ENV_FAISS)/lib \
	-L$(ENV_FAISS)/targets/x86_64-linux/lib \
	-Wl,-rpath,$(FAISS_INSTALL)/lib -Wl,-rpath,$(ENV_FAISS)/lib \
	-Wl,-rpath-link,$(FAISS_INSTALL)/lib -Wl,-rpath-link,$(ENV_FAISS)/lib $(EXTRA_LDFLAGS)
# The Faiss library is built with GPU support, so the CUDA runtime libraries are linked as well.
# libcurand is linked when the environment provides it.
FAISS_CURAND := $(if $(wildcard $(ENV_FAISS)/lib/libcurand.so),-lcurand,)
FAISS_LIBS := -lfaiss -lopenblas -lcudart -lcublas $(FAISS_CURAND) -lgomp -ldl -lpthread -lm

# ---------------------------------------------------------------- cuVS (CUDA 12.4 toolchain)
# Headers of cuVS and of its dependencies (RAFT, RMM, CCCL, ...) come from the cuVS install
# prefix and from the dependency directories of the cuVS CMake build (third_party/build/cuvs.sh).
CUVS_INSTALL ?= $(W)/build/cuvs/install
CUVS_BUILD_DIR ?= $(W)/build/cuvs/build
CUVS_DEPS ?= $(CUVS_BUILD_DIR)/_deps
RAFT_INCLUDE ?= $(CUVS_DEPS)/raft-src/cpp/include
CUTLASS_INCLUDE ?= $(CUVS_DEPS)/nvidiacutlass-src/include

CUVS_CXX := $(ENV_CUVS)/bin/x86_64-conda-linux-gnu-c++
CUVS_CXXFLAGS := -std=c++17 -O3 -fopenmp -DNDEBUG -fPIC -Wno-deprecated-declarations
CUVS_INCLUDES := \
	-I$(CUVS_INSTALL)/include \
	-I$(ENV_CUVS)/include \
	-I$(ENV_CUVS)/targets/x86_64-linux/include \
	-I$(RAFT_INCLUDE) \
	-I$(CUVS_DEPS)/raft-build/include \
	-I$(CUVS_DEPS)/rmm-src/include \
	-I$(CUVS_DEPS)/rmm-build/include \
	-I$(CUVS_DEPS)/cccl-src/thrust \
	-I$(CUVS_DEPS)/cccl-src/libcudacxx/include \
	-I$(CUVS_DEPS)/cccl-src/cub \
	-I$(CUVS_DEPS)/fmt-src/include \
	-I$(CUVS_DEPS)/spdlog-src/include \
	-I$(CUVS_DEPS)/nvtx3-src/c/include \
	-I$(CUVS_DEPS)/cuco-src/include \
	-I$(CUTLASS_INCLUDE) \
	-I$(CUVS_DEPS)/nvidiacutlass-build/include \
	-I$(COMMON) -I.
CUVS_DEFINES := \
	-DFMT_HEADER_ONLY=1 \
	-DSPDLOG_FMT_EXTERNAL \
	-DLIBCUDACXX_ENABLE_EXPERIMENTAL_MEMORY_RESOURCE \
	-DTHRUST_DEVICE_SYSTEM=THRUST_DEVICE_SYSTEM_CUDA \
	-DTHRUST_HOST_SYSTEM=THRUST_HOST_SYSTEM_CPP \
	-DTHRUST_DISABLE_ABI_NAMESPACE \
	-DTHRUST_IGNORE_ABI_NAMESPACE_ERROR
CUVS_LDFLAGS := -L$(CUVS_INSTALL)/lib -L$(ENV_CUVS)/lib \
	-L$(ENV_CUVS)/targets/x86_64-linux/lib \
	-Wl,-rpath,$(CUVS_INSTALL)/lib -Wl,-rpath,$(ENV_CUVS)/lib \
	-Wl,-rpath,$(ENV_CUVS)/targets/x86_64-linux/lib \
	-Wl,-rpath-link,$(CUVS_INSTALL)/lib -Wl,-rpath-link,$(ENV_CUVS)/lib $(EXTRA_LDFLAGS)
CUVS_LIBS := -lcuvs -lcudart -lcublas -lcusolver -lcusparse -lcurand -lnvJitLink \
	-lgomp -ldl -lpthread -lm
# Logger implementations generated by the RMM and RAFT builds
CUVS_LOGGER_SRCS := \
	$(CUVS_DEPS)/rmm-build/include/rmm/logger_impl/logger.cpp \
	$(CUVS_DEPS)/raft-build/include/raft/core/logger_impl/logger.cpp

.PHONY: all faiss cuvs clean

all: faiss cuvs

faiss: $(BIN_DIR)/faiss_hnsw $(BIN_DIR)/faiss_ivf_pq

cuvs: $(BIN_DIR)/cuvs_ivf_pq $(BIN_DIR)/cuvs_brute_force

$(BIN_DIR):
	mkdir -p $@

$(BIN_DIR)/faiss_hnsw: faiss_hnsw.cpp $(COMMON)/dataset_io.hpp | $(BIN_DIR)
	$(FAISS_CXX) $(FAISS_CXXFLAGS) $(FAISS_INCLUDES) $< -o $@ $(FAISS_LDFLAGS) $(FAISS_LIBS)

$(BIN_DIR)/faiss_ivf_pq: faiss_ivf_pq.cpp survey_profiler.hpp $(COMMON)/dataset_io.hpp | $(BIN_DIR)
	$(FAISS_CXX) $(FAISS_CXXFLAGS) $(FAISS_INCLUDES) $< -o $@ $(FAISS_LDFLAGS) $(FAISS_LIBS)

$(BIN_DIR)/cuvs_ivf_pq: cuvs_ivf_pq.cpp survey_profiler_cuvs_ivf.hpp $(COMMON)/dataset_io.hpp | $(BIN_DIR)
	$(CUVS_CXX) $(CUVS_CXXFLAGS) $(CUVS_DEFINES) $(CUVS_INCLUDES) \
		$< $(CUVS_LOGGER_SRCS) -o $@ $(CUVS_LDFLAGS) $(CUVS_LIBS)

$(BIN_DIR)/cuvs_brute_force: cuvs_brute_force.cpp survey_profiler.hpp $(COMMON)/dataset_io.hpp | $(BIN_DIR)
	$(CUVS_CXX) $(CUVS_CXXFLAGS) $(CUVS_DEFINES) $(CUVS_INCLUDES) \
		$< $(CUVS_LOGGER_SRCS) -o $@ $(CUVS_LDFLAGS) $(CUVS_LIBS)

clean:
	rm -f $(BIN_DIR)/faiss_hnsw $(BIN_DIR)/faiss_ivf_pq $(BIN_DIR)/cuvs_ivf_pq $(BIN_DIR)/cuvs_brute_force
